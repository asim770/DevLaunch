# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB default)
MONGODB_URI=mongodb://localhost:27017/devlaunch

# Cross-Origin Resource Sharing (Allowed Frontend Origin)
CLIENT_URL=http://localhost:3000

# Authentication & JWT Configuration
# Required: JWT_SECRET must be at least 32 characters long. Replace with a secure random string in production.
JWT_SECRET=devlaunch_development_jwt_secret_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Email Delivery Configuration (Password Reset & OTP)
# Options: 'console' (for local development only) or 'smtp' (required for production)
EMAIL_PROVIDER=console
EMAIL_FROM=DevLaunch <no-reply@devlaunch.local>
# Required when EMAIL_PROVIDER=smtp:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username_placeholder
SMTP_PASS=smtp_password_placeholder

# Google OAuth 2.0 Configuration (Optional in development)
# To enable Google sign-in, all three variables must be provided:
# GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
